{
  "name": "synaptix-command-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "start:api": "tsx apps/web/server/standalone.ts",
    "test": "npm --prefix apps/web test",
    "test:web": "npm --prefix apps/web test"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "tsx": "^4.19.3"
  }
}
