{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true
  },
  "include": [
    "src/server/standalone.ts",
    "src/lib/gemini/geminiService.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/server/vitePlugin.ts",
    "src/lib/gemini/geminiClient.ts"
  ]
}
