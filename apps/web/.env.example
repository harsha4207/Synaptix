# ==============================================================================
# SYNAPTIX COMMAND — Web Application Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit .env.local to version control.
# Never expose backend secrets or service_role keys in browser bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Authentication & Client Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://mctckddnapqlbqxqydcj.supabase.co
VITE_SUPABASE_URL=https://mctckddnapqlbqxqydcj.supabase.co

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# ------------------------------------------------------------------------------
# 2. Google Gemini API Integration (Server-Side Backend Only)
# Configure once in your .env.local. The Vite backend proxy keeps this secret server-side.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. ElevenLabs Voice Integration (Server-Side Backend Only)
# Optional: Used for neural TTS speech synthesis. Native Web Speech API is used as fallback.
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
